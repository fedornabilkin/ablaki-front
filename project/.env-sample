# При npm run dev запросы к API идут через /api/ на том же origin, что и Vite.
# Vite проксирует их на API_PROXY_TARGET; если он не задан, использует VITE_API_URL.
# Для production-сборки VITE_API_URL остаётся прямым адресом API с завершающим /.
# В GitHub Actions задаётся Repository variable VITE_API_URL.
# Для frontend по HTTPS API также должен быть доступен по HTTPS.
VITE_API_URL=http://localhost:3180/
# При необходимости можно направить локальный dev-прокси на другой бэкенд:
# API_PROXY_TARGET=http://localhost:3180/
# Если не задано или равно "mock" — чат работает в памяти браузера (без бэка).
# Для боевого бэка укажите адрес WS-брокера, например:
# VITE_WS_URL=ws://localhost:8088/connection/websocket
VITE_WS_URL=mock
# Крафт: 1 = in-memory (без бэка), 0 = реальные эндпоинты /v1/craft-*.
VITE_CRAFT_MOCK=1
# Статистика на главной и стене: 1 = фейковые данные (без бэка), 0 = реальные /v1/stat-*.
VITE_STAT_MOCK=1
VITE_CITY_MOCK=1
